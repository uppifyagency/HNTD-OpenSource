<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: skill/install.sh --launchd fills __PROJECT_DIR__ and __HOME__ into skill/cron/generated/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github-hr.poller</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/skill/scripts/poller.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/github-hr-logs/poller-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/github-hr-logs/poller-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
