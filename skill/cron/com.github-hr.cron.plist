<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: skill/install.sh --launchd fills __PROJECT_DIR__ and __HOME__ into skill/cron/generated/. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github-hr.cron</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/skill/cron/github-hr-cron.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/github-hr-logs/cron-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/github-hr-logs/cron-stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:__HOME__/.npm/bin:__HOME__/.local/bin</string>
    </dict>
</dict>
</plist>
