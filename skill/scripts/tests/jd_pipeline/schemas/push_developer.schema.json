{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["githubId", "login", "profileUrl", "followers", "publicRepos", "topLanguages", "topRepos", "indexedAt", "updatedAt"],
  "properties": {
    "githubId": {"type": "string"},
    "login": {"type": "string"},
    "name": {"type": ["string", "null"]},
    "email": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "bio": {"type": ["string", "null"]},
    "blog": {"type": ["string", "null"]},
    "avatarUrl": {"type": ["string", "null"]},
    "followers": {"type": "number", "minimum": 0},
    "publicRepos": {"type": "number", "minimum": 0},
    "profileUrl": {"type": "string"},
    "topLanguages": {"type": "array", "items": {"type": "string"}},
    "topRepos": {"type": "array"},
    "indexedAt": {"type": "number"},
    "updatedAt": {"type": "number"},
    "score": {"type": "number"},
    "scoreComment": {"type": "string"},
    "scoreBreakdown": {"type": "object"},
    "objectiveScore": {"type": "number"},
    "normalizedScore": {"type": "number"},
    "poolCategory": {"type": "string"},
    "jdScoreBreakdown": {"type": "object"},
    "jdAssessment": {"type": "string"},
    "repositoriesContributedTo": {"type": "array", "items": {"type": "string"}},
    "organizations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["login"],
      "properties": {"login": {"type": "string"}, "name": {"type": "string"}}}},
    "pinnedRepos": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string"}, "primaryLanguage": {"type": "string"}, "stars": {"type": "number"},
                     "forks": {"type": "number"}, "description": {"type": "string"}}}},
    "socialAccounts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["provider", "url"],
      "properties": {"provider": {"type": "string"}, "url": {"type": "string"}}}},
    "languageBytes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["language", "bytes"],
      "properties": {"language": {"type": "string"}, "bytes": {"type": "number"}}}},
    "commitsByRepo": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repo", "contributions"],
      "properties": {"repo": {"type": "string"}, "contributions": {"type": "number"}}}},
    "commitsPerRepo": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repo", "totalCount"],
      "properties": {"repo": {"type": "string"}, "totalCount": {"type": "number"}}}},
    "mergedPullRequestsByRepo": {"$ref": "#/$defs/repoCounts"},
    "releasesByRepo": {"$ref": "#/$defs/repoCounts"},
    "openIssuesByRepo": {"$ref": "#/$defs/repoCounts"},
    "watchersByRepo": {"$ref": "#/$defs/repoCounts"},
    "matchConfidence": {"type": "number"},
    "matchReason": {"type": "string"}
  },
  "$defs": {
    "repoCounts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repo", "count"],
      "properties": {"repo": {"type": "string"}, "count": {"type": "number"}}}}
  }
}
