{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["extractedParams", "scoringRubric", "searchStrategies", "version"],
  "properties": {
    "extractedParams": {
      "type": "object",
      "required": ["languages", "locations", "keywords", "senioritySignals", "roleType"],
      "properties": {
        "languages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "locations": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "senioritySignals": {"type": "array", "items": {"type": "string"}},
        "roleType": {"type": "string", "enum": ["frontend", "backend", "fullstack", "devops", "data", "mobile", "other"]}
      }
    },
    "scoringRubric": {
      "type": "object",
      "required": ["dimensions", "mustHave", "niceToHave", "dealBreakers"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "weight", "description", "signals"],
            "properties": {
              "name": {"type": "string"},
              "weight": {"type": "number", "minimum": 0, "maximum": 100},
              "description": {"type": "string"},
              "signals": {"type": "array", "items": {"type": "string"}}
            }
          },
          "minItems": 4,
          "maxItems": 6
        },
        "mustHave": {"type": "array", "items": {"type": "string"}},
        "niceToHave": {"type": "array", "items": {"type": "string"}},
        "dealBreakers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "searchStrategies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "priority", "rationale"],
        "properties": {
          "query": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "rationale": {"type": "string"}
        }
      },
      "minItems": 5
    },
    "version": {"type": "integer", "minimum": 1}
  }
}
