# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# E2E test artifacts
.env.test
e2e-test/.clerk-auth.json
e2e-test/*.png

# Screenshots / proof images
*.png

# Python virtual environments
.venv/
skill/scripts/.venv/
.venv-headroom/
__pycache__/
*.pyc

# Hypothesis property-testing databases (auto-generated cache)
.hypothesis/

# Skill scripts secrets
skill/scripts/.env

# Skill output
skill/output/

# launchd plists rendered by skill/install.sh --launchd
skill/cron/generated/

# Internal research docs
docs/research/

# Playwright MCP logs
.playwright-mcp/

# Test results
test-results/

# Claude Code local settings
.claude/settings.json

# worktrees
.worktrees/

# Non-Claude AI tool directories (generated by convex ai-files)
.codebuddy/
.commandcode/
.continue/
.crush/
.factory/
.goose/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
