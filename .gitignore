# local design references (cloned repos kept locally for reference, not versioned)
docs/design-references/
docs/hntd-redesign-v2/

# local dev tooling / skills (not app code); the pipeline's entry point and the verification skill are shipped
.claude/skills/*
!.claude/skills/github-hr/
!.claude/skills/verify/
artifacts/hiring-agent-src/
# nWave activation marker (keep .nwave/local-config.json trackable)
.nwave/*
!.nwave/local-config.json

# Generated by `convex dev`; the root tsconfig typechecks convex/ and cloud deploys never had one
convex/tsconfig.json
